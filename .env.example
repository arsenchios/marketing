# Local development defaults. Public pilot configuration below.
PORT=4350
APP_ORIGIN=http://127.0.0.1:4350
DATA_DIR=.data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PDFINFO_PATH=pdfinfo

# Optional managed TURN for speakers on different networks. Server-side master key only.
# Create a Cloudflare Realtime TURN key, then save these directly in Railway Variables.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Existing self-hosted/static RTCIceServer JSON remains supported through SPEAKER_ICE_SERVERS.


# Private Cloudflare R2 archive (server only; optional). Never expose these in VITE_*.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public deployment only (see docs/RAILWAY_PLAN.md):
# APP_MODE=public
# APP_ORIGIN=https://live.example.com
# DATA_DIR=/data
# DATABASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OWNER_EMAIL=
# TOKEN_ENCRYPTION_KEY=
# YOUTUBE_LIVE_ENABLED=true
# SPEAKER_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
